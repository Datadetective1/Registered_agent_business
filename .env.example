# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Canonical public URL (used for canonical tags, sitemap, Stripe redirects, email links).
APP_URL=http://localhost:3000
DATABASE_URL=postgres://app:app@localhost:5432/bizagent_dev

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# PAYMENTS_MODE: "stripe" | "simulated" | "disabled".
#   - simulated: local/CI only — a fake checkout page that runs the same fulfillment code.
#                Refused when NODE_ENV=production.
#   - stripe:    Stripe Checkout. Use TEST keys (sk_test_...). Live keys are refused unless
#                STRIPE_ALLOW_LIVE=true (do not set this until launch is explicitly approved).
# If unset: "stripe" when STRIPE_SECRET_KEY is present, otherwise "simulated" in development.
PAYMENTS_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT: "log" (default — store in DB/admin outbox, send nothing) | "resend"
EMAIL_TRANSPORT=log
EMAIL_FROM="Business Agent <support@example.com>"
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Storage / jobs
# ---------------------------------------------------------------------------
# Private document storage directory (must NOT be inside /public). Use a persistent volume in production.
STORAGE_DIR=./storage
# Bearer token required by POST /api/cron/daily (renewal reminders, cleanup).
CRON_SECRET=change-me-to-a-long-random-string
